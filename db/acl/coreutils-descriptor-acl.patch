 # include <linux/falloc.h>
 #endif
 
+/* Pin directory/special-file ACL operations to the objects selected by cp.
+   Do not reopen the displayed destination pathname after resolving its parent. */
+static int
+acl_destination_fd (int parent, char const *name)
+{
+  int fd = openat (parent, name, O_PATH | O_NOFOLLOW | O_CLOEXEC);
+  if (fd < 0)
+    return -1;
+  struct stat st;
+  int failed = fstat (fd, &st);
+  if (failed < 0 || S_ISLNK (st.st_mode))
+    {
+      int saved = errno;
+      if (failed == 0 && S_ISLNK (st.st_mode))
+        saved = ELOOP;
+      close (fd);
+      errno = saved;
+      return -1;
+    }
+  return fd;
+}
+
+int
+xcopy_acl_at (char const *src, struct stat const *expected,
+              char const *dst, int parent, char const *relative, mode_t mode)
+{
+  /* Follow an explicitly selected source link, but reject object substitution. */
+  int from = open (src, O_PATH | O_CLOEXEC);
+  struct stat st;
+  if (from < 0)
+    return -1;
+  int result = -1;
+  if (fstat (from, &st) == 0
+      && st.st_dev == expected->st_dev && st.st_ino == expected->st_ino)
+    {
+      int to = acl_destination_fd (parent, relative);
+      if (to >= 0)
+        {
+          result = xcopy_acl (src, from, dst, to, mode);
+          int saved = errno;
+          close (to);
+          errno = saved;
+        }
+    }
+  else
+    errno = ESTALE;
+  int saved = errno;
+  close (from);
+  errno = saved;
+  return result;
+}
+
+int
+xset_acl_at (char const *dst, int parent, char const *relative, mode_t mode)
+{
+  int fd = acl_destination_fd (parent, relative);
+  if (fd < 0)
+    return -1;
+  int result = xset_acl (dst, fd, mode);
+  int saved = errno;
+  close (fd);
+  errno = saved;
+  return result;
+}
+
